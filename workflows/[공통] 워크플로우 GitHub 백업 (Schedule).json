    {
      "parameters": {
        "jsCode": "// 워크플로우마다 GitHub에 커밋할 파일 1개씩 생성\nconst items = $input.all();\nconst stamp = DateTime.now().setZone('Asia/Seoul').toFormat('yyyy-MM-dd HH:mm');\nreturn items.map(it => {\n  const wf = it.json;\n  const safe = String(wf.name || wf.id).replace(/[\\/\\\\:*?\"<>|]/g, '_').replace(/\\s+/g, ' ').trim();\n  return {\n    json: {\n      fileName: `${safe}.json`,\n      content: JSON.stringify(wf, null, 2),\n      commitMessage: `backup: ${safe} (${stamp} KST)`\n    }\n  };\n});"
      },
      "id": "g3333333-3333-4333-8333-333333333333",
      "name": "백업 파일 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        304
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "edit",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "codefuling"
        },
        "repository": {
          "__rl": true,
